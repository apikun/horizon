<?xml version="1.0" encoding="utf-8"?>
<!-- Horizon on Android: a NativeActivity whose native library
     (libhorizon_android.so, from crates/horizon-android) is the whole app.
     No Java sources: android:hasCode="false". -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Multiplayer, the session services and the anonymous playing-count ping. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Horizon renders with wgpu: Vulkan where the device has it, GLES as
         the fallback. Vulkan is optional so the GLES path still installs. -->
    <uses-feature android:glEsVersion="0x00030000" android:required="true" />
    <uses-feature android:name="android.hardware.vulkan.version" android:required="false" />

    <application
        android:label="Horizon"
        android:icon="@mipmap/ic_launcher"
        android:hasCode="false"
        android:theme="@android:style/Theme.DeviceDefault.NoActionBar.Fullscreen"
        android:allowBackup="true">

        <activity
            android:name="android.app.NativeActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|smallestScreenSize|uiMode|density"
            android:launchMode="singleTask"
            android:resizeableActivity="true">
            <meta-data
                android:name="android.app.lib_name"
                android:value="horizon_android" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
